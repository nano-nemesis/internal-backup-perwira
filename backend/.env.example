APP_NAME=internal-backup-perwira
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=internal_backup_perwira
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=cookie
# Menit, sliding: tiap request memperpanjang. 30 hari supaya aplikasi yang
# dipasang di layar utama HP tidak minta login lagi tiap dibuka (cookie PWA iOS
# terpisah dari Safari, jadi login ulang di sana terasa sekali).
SESSION_LIFETIME=43200
# Kosongkan (null) untuk akses lewat IP atau satu host. Mengisi 'localhost'
# membuat browser TIDAK pernah mengirim cookie sesi ke host lain.
SESSION_DOMAIN=null
# WAJIB true begitu aplikasi disajikan lewat HTTPS — tanpa ini cookie sesi
# ikut terkirim di koneksi polos.
SESSION_SECURE_COOKIE=false
# Harus memuat host/IP yang dipakai mengakses dashboard, kalau tidak login
# tidak akan pernah 'nempel'.
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

BACKUP_RETENTION_DAYS=7
ACTIVITY_LOG_RETENTION_DAYS=90
SSH_TIMEOUT=30
BACKUP_TIMEZONE=Asia/Jakarta

ALERT_COOLDOWN_MINUTES=30

FRONTEND_DIR=../frontend/dist
