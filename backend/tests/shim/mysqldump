#!/bin/sh
# mysqldump palsu untuk tests/lanjutan-semua-db.php. Mencatat database yang diminta;
# ada berkas gagal-<db> di folder ini = putus di tengah dump (header tertulis, exit 2).
dir=$(dirname "$0")
for a; do db=$a; done
echo "$db" >> "$dir/calls"
printf -- '-- MySQL dump 10.13  Distrib 8.0.46\nCREATE TABLE `t` (id int);\nINSERT INTO `t` VALUES (1);\n'
if [ -e "$dir/gagal-$db" ]; then echo "mysqldump: Got error: 2013: Lost connection to MySQL server during query" >&2; exit 2; fi
printf -- '-- Dump completed on 2026-11-16 15:00:00\n'
